CLERK_PUBLISHABLE_KEY=pk_test_x
PORT=3000

# create an OAuth app in your Codeforces API settings
CF_CLIENT_ID=
CF_CLIENT_SECRET=
PUBLIC_URL=https://cfrace.wnbase.com

# set to 1 when behind a reverse proxy
TRUST_PROXY=1







# DEVELOPMENT; does not require CF verification
# ALLOW_UNVERIFIED_HANDLE=1
# Required in production. Never expose SUPABASE_KEY to the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVER_SECRET_OR_SERVICE_ROLE_KEY

# Optional local-only testing; rejected on Render. Initialize state.json explicitly.
# STORAGE_BACKEND=file
# STATE_FILE=./state.json

# Clerk user ID (user_...), not a username. Create/name your account admin in Clerk.
ADMIN_CLERK_USER_ID=
